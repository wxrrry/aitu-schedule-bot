# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID чата или группы куда отправлять расписание (например -1001234567890 или ваш user ID)
CHAT_ID=your_chat_id_here

# Часовой пояс (по умолчанию Europe/Moscow)
TIMEZONE=Europe/Moscow

# Опорная дата и её тип для расчёта числителя/знаменателя
# Понедельник 12.10.2026 — числитель
ANCHOR_DATE=2026-10-12
ANCHOR_PARITY=chislitel

# Telegram ID администратора (необязательно, для эксклюзивных команд)
ADMIN_ID=
